{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    // node is here for vite.config.ts, which reads process.env to point the dev proxy at
    // a running API. Nothing under src/ may use it — the bundle has no Node runtime.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
