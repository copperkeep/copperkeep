{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Copperkeep values",
  "description": "The person installing this at a tutoring center is an admin, not a Helm author. A typo should produce a sentence, not a template error forty lines deep.",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "ingress", "api", "postgres"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["registry", "repository"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "object" } }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["host"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "The single public origin. Everything is path-routed behind it."
        },
        "annotations": { "type": "object" },
        "crossOriginIsolationHeaders": { "type": "boolean" },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "defaultTheme": { "enum": ["auto", "light", "dark"] },
        "extra": { "type": "object" }
      }
    },
    "web": { "$ref": "#/definitions/staticService" },
    "runtimes": { "$ref": "#/definitions/staticService" },
    "content": {
      "allOf": [
        { "$ref": "#/definitions/staticService" },
        {
          "properties": {
            "tag": {
              "type": "string",
              "description": "Curriculum calendar version, e.g. 2026.09.1. Independent of the app's semver."
            }
          }
        }
      ]
    },
    "audio": {
      "allOf": [
        { "$ref": "#/definitions/staticService" },
        {
          "properties": {
            "enabled": { "type": "boolean" },
            "tag": { "type": "string" }
          }
        }
      ]
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "logLevel": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] },
        "resources": { "type": "object" },
        "cookieSecure": {
          "type": ["boolean", "null"],
          "description": "Whether the browser is on HTTPS. null follows ingress.tls.enabled; set true when TLS is terminated in front of the cluster."
        },
        "sessionSecret": { "type": "string" },
        "adminToken": { "type": "string" },
        "existingSecret": { "type": "string" },
        "auth": {
          "type": "object",
          "properties": {
            "backoffAfter": { "type": "integer", "minimum": 1 },
            "hardLockAfter": { "type": "integer", "minimum": 2 }
          }
        },
        "quotas": {
          "type": "object",
          "properties": {
            "eventWritesPerMinute": { "type": "integer", "minimum": 1 },
            "submissionMaxBytes": { "type": "integer", "minimum": 1024 }
          }
        },
        "mastery": {
          "type": "object",
          "properties": {
            "threshold": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "P(known) at which a skill counts as mastered. 0.90 is a starting guess, not a finding."
            },
            "minOpportunities": { "type": "integer", "minimum": 1 },
            "minStepTypes": {
              "type": "integer",
              "minimum": 1,
              "description": "A skill is not mastered from one step type alone."
            },
            "reviewIntervalsDays": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "bootstrap": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "orgSlug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "orgName": { "type": "string" },
            "adminUsername": { "type": "string", "minLength": 1 },
            "adminPassword": { "type": "string" }
          }
        }
      }
    },
    "reviewScheduler": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 9 }
      }
    },
    "tutor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "baseUrl": { "type": "string", "format": "uri" },
        "model": { "type": "string" },
        "apiKeySecret": { "type": "string" },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "description": "An 8s budget and a 7B model on N100 CPU are mutually exclusive; the service measures p95 at startup and disables guidance if it cannot meet this."
        },
        "latencyGate": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "probeOnStart": { "type": "boolean" }
          }
        },
        "features": {
          "type": "object",
          "properties": {
            "guidance": { "type": "boolean" },
            "reporting": { "type": "boolean" }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["embedded", "operator", "external"],
          "description": "embedded is correct for a family or single classroom; operator earns its cost for a multi-tenant customer; external points at a managed instance."
        },
        "image": { "type": "string" },
        "database": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "password": { "type": "string" },
        "existingSecret": { "type": "string" },
        "externalUrl": { "type": "string" },
        "externalUrlSecret": { "type": "string" },
        "externalUrlSecretKey": { "type": "string" },
        "storage": {
          "type": "object",
          "properties": {
            "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
            "className": { "type": "string" }
          }
        },
        "resources": { "type": "object" },
        "backup": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "schedule": { "type": "string" },
            "retentionDays": { "type": "integer", "minimum": 1 },
            "existingClaim": {
              "type": "string",
              "description": "A PVC you already back up elsewhere. Preferred: a chart-created claim shares the database's storage, and stays Pending on WaitForFirstConsumer classes."
            },
            "storage": {
              "type": "object",
              "properties": {
                "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" },
                "className": { "type": "string" }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "external" } }, "required": ["mode"] },
          "then": {
            "anyOf": [
              { "properties": { "externalUrl": { "type": "string", "minLength": 1 } }, "required": ["externalUrl"] },
              { "properties": { "externalUrlSecret": { "type": "string", "minLength": 1 } }, "required": ["externalUrlSecret"] }
            ]
          }
        }
      ]
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "type": "object" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  },
  "definitions": {
    "staticService": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    }
  }
}
