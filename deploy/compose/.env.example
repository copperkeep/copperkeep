# Copy to .env and fill in. Both required values fail the stack loudly if unset.

POSTGRES_PASSWORD=change-me
COPPERKEEP_SESSION_SECRET=change-me-to-48-random-characters
COPPERKEEP_ADMIN_TOKEN=change-me-to-32-random-characters

# Creates the first adult account on first boot. Never overwrites an existing one.
COPPERKEEP_BOOTSTRAP_ADMIN_USERNAME=admin
COPPERKEEP_BOOTSTRAP_ADMIN_PASSWORD=

# Application semver and curriculum calendar version move independently.
COPPERKEEP_VERSION=0.1.0
COPPERKEEP_CURRICULUM_VERSION=2026.09.1

COPPERKEEP_HTTP_PORT=8443

# localhost is a secure context over plain HTTP, so this can stay false while you are
# testing on the box itself. The moment anyone reaches this over the LAN it must be
# true, behind TLS — SharedArrayBuffer, service workers and storage.persist() all need a
# secure context, and 192.168.x.x over HTTP is not one.
COPPERKEEP_COOKIE_SECURE=false

COPPERKEEP_TUTOR_ENABLED=false
